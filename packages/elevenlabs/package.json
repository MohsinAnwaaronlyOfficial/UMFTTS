    "test:watch": "vitest"
  },
  "dependencies": {
    "@umf-tts/shared": "workspace:*",
    "form-data": "^4.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
